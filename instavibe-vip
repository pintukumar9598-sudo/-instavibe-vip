    window.copyText = function(txt, isEncoded = false, silent = false) {
      if(isEncoded) txt = decodeURIComponent(txt);
      
      // Robust Fallback Copy Method
      let textArea = document.createElement("textarea");
      textArea.value = txt;
      textArea.style.position = "fixed";
      textArea.style.left = "-999999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try { document.execCommand('copy'); } catch(e){}
      textArea.remove();

      if(!silent) showSysToast("Copied to clipboard!");
    };
    
    function showSysToast(msg) {
